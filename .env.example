# NSP API proxy configuration
# Base URL of your NSP instance, e.g. https://helix2.example.com
NSP_BASE_URL=https://your-nsp-host.example.com

# Option A (testing): paste a token directly. If set, the proxy uses this and
# skips the login call entirely. Useful for quick smoke tests.
# NSP_API_TOKEN=paste-token-here

# Option B (normal): credentials used to fetch + refresh a token via
# POST /api/logon/getauthenticationtoken?email=...&password=...
NSP_EMAIL=apiuser@example.com
NSP_PASSWORD=replace-me

# Server port
PORT=3000
