# NSP API proxy configuration
# Base URL of your NSP instance, e.g. https://helix2.example.com
NSP_BASE_URL=https://your-nsp-host.example.com

# API token. Sent as `Authorization: Bearer ${NSP_API_TOKEN}` by default.
# If your NSP build uses a different header, set NSP_AUTH_HEADER / NSP_AUTH_SCHEME.
NSP_API_TOKEN=replace-me

# Optional overrides
# NSP_AUTH_HEADER=Authorization
# NSP_AUTH_SCHEME=Bearer

# Server port
PORT=3000
